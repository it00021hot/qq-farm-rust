# qq-farm-rust 环境变量示例
# 复制到 .env 并填入实际值

# === 游戏 WebSocket 配置 ===
FARM_SERVER_URL=https://game.qq.com
FARM_OS=linux
FARM_CLIENT_VERSION=1.0.0

# === 默认账号 ID（fallback） ===
# FARM_ACCOUNT_ID=

# === HTTP 服务 ===
ADMIN_PORT=3007

# === 日志 ===
RUST_LOG=info

# === 数据目录（默认 ~/.qq-farm-rust） ===
# FARM_DATA_DIR=

# === 微信扫码登录（可选） ===
# WX_APP_ID=
# WX_BIZ_ID=
