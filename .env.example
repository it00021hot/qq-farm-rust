# qq-farm-rust 环境变量示例
# 复制到 .env 并填入实际值

# === 游戏 WebSocket 配置 ===
FARM_SERVER_URL=wss://gate-obt.nqf.qq.com/prod/ws
FARM_OS=Windows
FARM_CLIENT_VERSION=1.13.2.8_20260723

# === 默认账号 ID（fallback） ===
# FARM_ACCOUNT_ID=

# === HTTP 服务 ===
ADMIN_PORT=3007

# === 日志 ===
RUST_LOG=info

# === 数据目录（server 默认 <app_root>/data；桌面安装包默认 OS 应用数据目录 QQFarmRust） ===
# FARM_DATA_DIR=

# === 微信扫码登录（可选） ===
# WX_APP_ID=
# WX_BIZ_ID=
